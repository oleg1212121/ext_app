# Prod DB credentials for the postgres container.
# The postgres image reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB natively.
# Copy to `postgres.env` and set STRONG random values. These MUST match
# DB_USERNAME / DB_PASSWORD / DB_DATABASE in laravel/.env.production
# (used by the Laravel app + queue workers).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ext_app
