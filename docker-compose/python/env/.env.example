# Copy to `.env` and adjust. Loaded by docker-compose via env_file (services.python).
# Edits to runtime knobs (ALIGN_DEFAULT_*) apply on the next request without restart.
# Edits to MODEL_PATH/ALIGN_MODEL_PATH apply on the next request that lazy-loads
# the model (only the first call after the path actually re-reads env).

# Named volume is mounted at /app/models/<subdir>.
MODEL_PATH=/app/models/bge_m3
ALIGN_MODEL_PATH=/app/models/minilm

# Set to 0 only when running /app/scripts/download_model.py to fetch a model.
HF_HUB_OFFLINE=1

# Validation limits (mirror Laravel contracts; read once at import).
EMBED_MAX_TEXT_LENGTH=1000000
EMBED_BATCH_MAX_TEXTS=100
COSINE_MAX_CANDIDATES=2000
SPLIT_MAX_TEXT_LENGTH=5242880
ALIGN_MAX_SENTENCES=500
ALIGN_MAX_WINDOW=8

# Live per-request defaults (edited without restart).
ALIGN_DEFAULT_WINDOW=3
ALIGN_DEFAULT_THRESHOLD=0.4

# Optional: pin torch CPU threads (defaults to all cores if blank).
TORCH_NUM_THREADS=