# Copy to `.env` and adjust. Loaded by docker-compose via env_file (services.python).
# Edits to runtime knobs (ALIGN_DEFAULT_*) apply on the next request without restart.
# Edits to MODEL_PATH/ALIGN_MODEL_PATH apply on the next request that lazy-loads
# the model (only the first call after the path actually re-reads env).

# Named volume is mounted at /app/models/<subdir>.
MODEL_PATH=/app/models/bge_m3
ALIGN_MODEL_PATH=/app/models/labse

# Set to 0 only when running /app/scripts/download_model.py to fetch a model.
HF_HUB_OFFLINE=1

# Validation limits (mirror Laravel contracts; read once at import).
EMBED_MAX_TEXT_LENGTH=1000000
EMBED_BATCH_MAX_TEXTS=100
COSINE_MAX_CANDIDATES=2000
SPLIT_MAX_TEXT_LENGTH=5242880
# Sentence splitter backend: "razdel" (rule-based, default) or "pysbd" (ML-heuristic).
# SPLITTER_ENGINE=razdel
SPLITTER_ENGINE=pysbd
ALIGN_MAX_SENTENCES=500
ALIGN_MAX_WINDOW=8

# Live per-request defaults (edited without restart).
ALIGN_DEFAULT_WINDOW=3
# Greedy gap-search ladder: compare window steps 1..ALIGN_PRIMARY_WINDOW as one
# set and take the highest-scoring combo above threshold (a 1:1 no longer
# auto-commits on threshold); if none clears the bar, widen one step per side
# up to max_window. Growth ceiling stays max_window (PHP's max_n, default 6).
ALIGN_PRIMARY_WINDOW=3
# Below-threshold windows are skipped (unmatched) instead of force-matched.
# Lowered 0.75 -> 0.55 (Aug 2026): real LaBSE scores on adapted learning texts
# (e.g. The Gamblers titles 0.58/0.66) sit below the old provisional 0.75;
# 0.55 matches the MiniLM garbage-floor calibration (LaBSE runs hotter, so it
# stays conservative). LaBSE max_seq_length=256; over-cap windows are truncated.
ALIGN_DEFAULT_THRESHOLD=0.55
# Reject match edges whose en_step + ru_step exceed this cap (1:5 / 5:1 spans
# are almost never genuine translations).
ALIGN_MAX_TOTAL_SPAN=6
# Per-sentence cost of consuming a sentence without a match. Negative; the DP
# prefers skipping over a below-threshold force-match (-2.0).
ALIGN_SKIP_PENALTY=-0.5
# Alignment algorithm: "greedy" (anchor-first greedy — fast, embeds each
# sentence once plus rare window expansions) or "dp" (full window DP — slowest
# with a big model, embeds (n + m) * max_window windows).
ALIGN_ALGORITHM=greedy
# Confident 1:1 bar used by the greedy mode to lock anchors; the remaining gaps
# are aligned greedily with on-demand window expansions.
ALIGN_ANCHOR_THRESHOLD=0.6
# Greedy orphan-merge post-pass: after anchoring, a match whose following gap
# has orphans on exactly one side may be extended over that orphan run (bounded
# by max_window / ALIGN_MAX_TOTAL_SPAN) when the pooled window beats the match's
# score by at least this margin (e.g. a partial 1:1 anchor + adjacent orphan
# that together form a genuine 2:1).
ALIGN_MERGE_MARGIN=0.02
# 1:1 prepass anchor bar (Plan 03): mutually best cells at/above this cosine are
# locked as committed matches that split the chunk into sub-pools.
ALIGN_HIGH_CONFIDENCE=0.9
# Diagonal-banding plan (Plan 04+): match edges are restricted to a band of this
# half-width around the expected length-ratio diagonal. Blank/None derives the
# band per chunk as max(2, max_window).
ALIGN_BAND_WIDTH=
# Embedding-aggregation plan (Plan 05+): "aggregate" embeds each sentence once
# and combines vectors length-weighted + L2-normalized; "joined" keeps today's
# join-then-embed concatenation. Anything else coerces to "aggregate".
ALIGN_WINDOW_EMBED=aggregate

# Optional: pin torch CPU threads (defaults to all cores if blank).
TORCH_NUM_THREADS=