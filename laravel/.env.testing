APP_NAME=Laravel
APP_ENV=testing
# Throwaway key for tests only — do not copy the real APP_KEY here (this file is committed).
APP_KEY=base64:94tzcS36LwLZC4BujS59C5DZWML3vRtFefQuQZDa79c=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# Test database only. Never point this at ext_app — tests wipe the resolved DB.
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=54321
DB_DATABASE=ext_app_test
DB_USERNAME=test
DB_PASSWORD=test

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array

# No real AI provider keys in the test environment.
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=

DEBUGBAR_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
