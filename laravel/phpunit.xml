<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Two jobs need more than the 128M CLI default in one process: the
             full sequential suite's peak memory (Filament pages dominate), and
             Pest TIA's CoverageMerger, which runs in the parent pest process
             and needs more than 512M on ~1000-test suites. This <ini> is the
             single effective source of the limit: PHPUnit applies it via
             ini_set() at config load, in every process that loads the config
             (the parent and each paratest worker alike), so it outranks
             `php -d` flags and PHP_INI_SCAN_DIR ini files. Guarded by
             tests/Unit/TestProcessMemoryLimitTest.php. -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="testing" force="true"/>
        <env name="DB_TEST_DATABASE" value="ext_app_test" force="true"/>
        <env name="DB_DATABASE" value="ext_app_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="OPENROUTER_API_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
