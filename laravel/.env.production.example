APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ext-app.abibook.xyz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily-rotated, warning-level logs (LOG_STACK=daily makes the stack channel rotate; single would not)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Points at the postgres service on the docker network (not the host-mapped 54321).
# Strong DB_PASSWORD required (launch 1.3) — must match POSTGRES_PASSWORD in the prod compose env.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ext_app
DB_USERNAME=
DB_PASSWORD=
# Placeholder only — inert until Phase 3.2 wires env('DB_SSLMODE') into config/database.php
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ext-app.abibook.xyz
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Must exceed the longest job timeout (AlignEntitySentences, 600s)
DB_QUEUE_RETRY_AFTER=660

# Mail (Resend) — fill RESEND_API_KEY after creating it in the Resend dashboard (launch 1.7)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@ext-app.abibook.xyz
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# AI providers — fill with rotated keys (launch 1.2)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINFACE_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=

# Outbound proxy — leave commented out if not in use (launch 1.3)
# PROXY_LOGIN=
# PROXY_PASSWORD=
# PROXY_IP=
# PROXY_PORT=

# Python ML service (signatures, splitting, alignment)
PYTHON_API_URL=http://ext_python:8000
PYTHON_TIMEOUT=30
PYTHON_ALIGN_TIMEOUT=600

# Admin credentials — strong random password; used by `php artisan admin:create` against the prod DB
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
