# Excluded from the repo-root Docker build context. The dev image
# (LaravelDockerfile) COPYs no source (code is bind-mounted at runtime), so
# this file exists to keep `docker compose build app` contexts lean and free
# of host data. The python image has its own context (.dockerignore under
# docker-compose/python/).

# Host data: DB clusters, model weights, venvs, prod runtime state — multi-GB,
# never upload them as build context
docker-compose/postgres
docker-compose/prod
docker-compose/python/models
docker-compose/python/ai/venv
docker-compose/python/ai/ai_env
docker-compose/embedding/models

# Dev runtime state (recreated on demand)
laravel/node_modules
laravel/vendor
laravel/public/build
laravel/public/hot
laravel/bootstrap/cache
laravel/storage/logs/*
laravel/storage/debugbar/*
laravel/storage/framework/cache/*
laravel/storage/framework/sessions/*
laravel/storage/framework/views/*
laravel/storage/app/public/*
laravel/storage/app/laravel-excel/*

# Secrets, large dumps, editor/IDE, agent scratch
backup11.sql
**/.env
.git
.github
.idea
.vscode
.cursor
.agents
.claude
.plans
.playwright-mcp
trash
*.md
session-ses_01d8.md
alignments-plan.md
homepage-current.png
test_render.html
